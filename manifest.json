{
  "manifest_version": 3,
  "name": "PromptSnap",
  "version": "0.2.0",
  "description": "一键将预设 Prompt 填入 AI 输入框 (支持任意网站)",
  "permissions": [
    "storage",
    "identity"
  ],
  "oauth2": {
    "client_id": "336433447993-kd5bnl8phvqq0ob4ohuv1idoe57hq0df.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon16.png",
      "128": "icons/icon16.png"
    }
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "scripts/content.js"
      ],
      "css": [
        "styles/content.css"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon16.png",
    "128": "icons/icon16.png"
  }
}
